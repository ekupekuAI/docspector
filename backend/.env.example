APP_NAME=Docspector
APP_VERSION=0.1.0
APP_ENV=production
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./docspector.db
JWT_SECRET_KEY=<generate-a-random-256-bit-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_DIR=./storage/private
DEMO_MODE=false
CORS_ALLOWED_ORIGINS=https://your-production-frontend.example
